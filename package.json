{
  "name": "english-70-day-learning-system",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "content:analyze": "python3 scripts/content/normalize-source.py",
    "content:build": "python3 scripts/content/build-70-day-plan.py",
    "content:validate": "python3 scripts/content/validate-plan.py",
    "content:report": "python3 scripts/content/generate-report.py"
  },
  "dependencies": {
    "vue": "^3.3.4",
    "vue-router": "^4.2.4",
    "pinia": "^2.1.4",
    "dexie": "^3.2.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^4.2.3",
    "typescript": "^5.1.6",
    "vite": "^4.4.9",
    "vue-tsc": "^1.8.8"
  }
}
